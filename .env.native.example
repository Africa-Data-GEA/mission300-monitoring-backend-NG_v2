# Template for running the API outside Docker, with Postgres and RabbitMQ on localhost.
# Copy this file to .env.development. Docker setups use .env.example instead.
#

# Application
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (required)
# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
POSTGRES_USER=m300
POSTGRES_PASSWORD=m300
POSTGRES_DB=m300
DATABASE_URL=postgresql://m300:m300@localhost:5432/m300?schema=public

# RabbitMQ (required)
# Keep RABBITMQ_USER/RABBITMQ_PASSWORD consistent with RABBITMQ_URL.
RABBITMQ_USER=m300
RABBITMQ_PASSWORD=m300
RABBITMQ_URL=amqp://m300:m300@localhost:5672

# Authentication (required)
# Use a long, random value. Do not reuse a production secret.
JWT_SECRET=change-me-with-a-long-random-jwt-secret

# Initial administrator (optional)
# Leave both blank to skip automatic administrator creation, then run the seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email delivery (optional)
# Leave RESEND_API_KEY blank to log emails locally instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=Mission 300 Compact Monitoring Platform <notifications@example.com>

# Kestra workflow service (optional; used by `pnpm docker:kestra`)
KESTRA_HOST_PORT=8082
KESTRA_ADMIN_USERNAME=admin@kestra.io
KESTRA_ADMIN_PASSWORD=kestra
SECRET_AMQP_USERNAME=bTMwMA==
SECRET_AMQP_PASSWORD=bTMwMA==

# Deployment automation (not required for ordinary local development)
DEPLOY_HEALTH_CHECK_URL=http://localhost:3000/health
