# Local development environment template
#
# 1. Copy this file to .env.development.
# 2. Replace every `change-me-*` value with your own secret.
# 3. Never commit .env.development or real credentials.
#
# Docker Compose resolves `postgres` and `rabbitmq` as internal service names.

# Application
API_HOST_PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (required)
# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
POSTGRES_USER=m300
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=m300
DATABASE_URL=postgresql://m300:change-me-postgres-password@postgres:5432/m300?schema=public

# RabbitMQ (required)
# Keep RABBITMQ_USER/RABBITMQ_PASSWORD consistent with RABBITMQ_URL.
RABBITMQ_USER=m300
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_URL=amqp://m300:change-me-rabbitmq-password@rabbitmq:5672

# Authentication (required)
# Use a long, random value. Do not reuse a production secret.
JWT_SECRET=change-me-with-a-long-random-jwt-secret

# Initial administrator (optional)
# Leave both blank to skip automatic administrator creation, then run the seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email delivery (optional)
# Leave RESEND_API_KEY blank to log emails locally instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=M300 Compact Dashboard <notifications@example.com>

# Kestra workflow service (optional; used by `pnpm docker:kestra`)
KESTRA_HOST_PORT=8082
KESTRA_ADMIN_USERNAME=admin@kestra.io
KESTRA_ADMIN_PASSWORD=change-me-kestra-password
SECRET_AMQP_USERNAME=change-me-kestra-amqp-username
SECRET_AMQP_PASSWORD=change-me-kestra-amqp-password

# Deployment automation (not required for ordinary local development)
DEPLOY_HEALTH_CHECK_URL=http://localhost:3000/health
