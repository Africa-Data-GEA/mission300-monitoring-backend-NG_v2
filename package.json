{
  "name": "m300-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Mission 300 Compact Monitoring Platform - API",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "type": "commonjs",
  "scripts": {
    "build": "nest build && tsc -p prisma/tsconfig.scripts.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc -b --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "check": "pnpm verify && pnpm build",
    "docker:dev": "docker compose -f docker/docker-compose.yml --env-file .env.development up --watch",
    "docker:kestra": "docker compose -p m300-ng-backend -f docker/docker-compose.yml -f docker/docker-compose.override.yml --env-file .env.development --profile kestra up --detach kestra",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env.development up --watch",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env.development down",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file .env.development logs --follow api",
    "docker:ps": "docker compose -f docker/docker-compose.yml --env-file .env.development ps",
    "docker:build": "docker build -f docker/Dockerfile -t m300-backend:local .",
    "docker:config": "docker compose -f docker/docker-compose.yml --env-file .env.development config --quiet",
    "docker:api:build": "docker compose -f docker/docker-compose.yml --env-file .env.development exec -T api pnpm build",
    "docker:prisma:generate": "docker compose -f docker/docker-compose.yml --env-file .env.development exec -T api pnpm prisma:generate",
    "docker:prisma:migrate:deploy": "docker compose -f docker/docker-compose.yml --env-file .env.development exec -T api pnpm prisma:migrate:deploy",
    "docker:prisma:seed": "docker compose -f docker/docker-compose.yml --env-file .env.development exec -T api pnpm prisma:seed",
    "docker:prisma:seed:reference": "docker compose -f docker/docker-compose.yml --env-file .env.development exec -T api pnpm prisma:seed:reference -- --force",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:reference": "node prisma/seed-reference-data.mjs --force",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jszip": "3.10.2",
    "nestjs-pino": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.27.0",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@scarf/scarf",
      "argon2",
      "prisma"
    ],
    "overrides": {
      "multer": ">=2.3.0",
      "uuid@<11.1.1": ">=11.1.1",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mysql2@<=3.23.0": ">=3.23.1"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/../test/helpers/uuid-shim.js",
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
